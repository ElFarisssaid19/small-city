{
  "name": "small-city",
  "private": true,
  "version": "0.1.0",
  "description": "A small browser city-builder made with three.js and TypeScript.",
  "author": "Said El Fariss",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  }
}
